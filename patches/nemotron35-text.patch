diff --git a/exllamav3/architecture/nemotronh_omni_text.py b/exllamav3/architecture/nemotronh_omni_text.py
new file mode 100644
index 0000000..f22bf12
--- /dev/null
+++ b/exllamav3/architecture/nemotronh_omni_text.py
@@ -0,0 +1,66 @@
+"""Text-only Nemotron 3.5 Super VL adapter, retaining the original tensor names.
+
+This deliberately exposes no vision component. Image/video embeddings and the
+C-RADIO encoder need a separate implementation and validation.
+"""
+from __future__ import annotations
+
+from functools import cached_property
+
+from .nemotronh import NemotronHConfig, NemotronHModel
+from ..util.file import read_dict
+
+
+def text_config_view(config: dict) -> dict:
+    """Normalize the nested Transformers config without modifying saved metadata."""
+    text = dict(config["llm_config"])
+    if text.get("model_type") != "nemotron_h":
+        raise ValueError("Nemotron Omni text adapter requires a nemotron_h language model")
+    for quant in (config.get("quantization_config"), text.get("quantization_config")):
+        if quant and quant.get("quant_method") != "exl3":
+            raise ValueError("Nemotron Omni text import requires BF16 or EXL3 weights, not NVFP4")
+
+    block_codes = {"mamba": "M", "attention": "*", "moe": "E", "mlp": "-"}
+    for source, target in (
+        ("layers_block_type", "hybrid_override_pattern"),
+        ("mtp_layers_block_type", "mtp_hybrid_override_pattern"),
+    ):
+        blocks = text.get(source)
+        if blocks is not None:
+            if not isinstance(blocks, list) or any(b not in block_codes for b in blocks):
+                raise ValueError(f"Unsupported {source}: {blocks}")
+            pattern = "".join(block_codes[b] for b in blocks)
+            if target in text and text[target] != pattern:
+                raise ValueError(f"Conflicting {source} and {target}")
+            text[target] = pattern
+    count = len(text["hybrid_override_pattern"])
+    if text.get("num_hidden_layers", count) != count:
+        raise ValueError("Layer count does not match layers_block_type")
+    text["num_hidden_layers"] = count
+    # The publisher encodes infinity as a tagged JSON object.
+    if "time_step_limit" in text:
+        text["time_step_limit"] = [
+            float("inf") if value == {"__float__": "Infinity"} else value
+            for value in text["time_step_limit"]
+        ]
+    return text
+
+
+class NemotronHOmniTextConfig(NemotronHConfig):
+    arch_string = "NemotronH_Omni_Reasoning_V3"
+    tensor_prefix = "language_model."
+
+    @cached_property
+    def text_config(self):
+        return text_config_view(self.config_dict)
+
+    def read_cfg(self, *args):
+        return read_dict(self.text_config, *args)
+
+    def __init__(self, directory: str, **kwargs):
+        super().__init__(directory, **kwargs)
+        self.model_classes["text"] = NemotronHOmniTextModel
+
+
+class NemotronHOmniTextModel(NemotronHModel):
+    config_class = NemotronHOmniTextConfig
diff --git a/tests/model_setup/test_nemotronh_omni_text.py b/tests/model_setup/test_nemotronh_omni_text.py
new file mode 100644
index 0000000..9120bad
--- /dev/null
+++ b/tests/model_setup/test_nemotronh_omni_text.py
@@ -0,0 +1,115 @@
+"""Nested config loading, text-only capabilities and legacy tensor-name regressions."""
+import copy
+import json
+import math
+
+import pytest
+import torch
+from safetensors.torch import save_file
+
+from exllamav3 import Config, Model
+from exllamav3.architecture.nemotronh_omni_text import text_config_view
+
+pytestmark = pytest.mark.nogpu
+
+
+def source_config():
+    return {
+        "architectures": ["NemotronH_Omni_Reasoning_V3"],
+        "model_type": "nemotron_h_omni",
+        "llm_config": {
+            "architectures": ["NemotronHForCausalLM"],
+            "model_type": "nemotron_h",
+            "layers_block_type": ["mamba", "moe", "attention"],
+            "mtp_layers_block_type": ["attention", "moe"],
+            "hidden_size": 256,
+            "head_dim": 64,
+            "num_attention_heads": 4,
+            "num_key_value_heads": 2,
+            "mamba_num_heads": 8,
+            "mamba_head_dim": 64,
+            "ssm_state_size": 16,
+            "n_groups": 2,
+            "time_step_limit": [0.0, {"__float__": "Infinity"}],
+            "intermediate_size": 128,
+            "mlp_hidden_act": "relu2",
+            "n_routed_experts": 24,
+            "num_experts_per_tok": 22,
+            "moe_intermediate_size": 128,
+            "moe_shared_expert_intermediate_size": 256,
+            "moe_latent_size": 64,
+            "routed_scaling_factor": 5.0,
+            "n_group": 1,
+            "topk_group": 1,
+            "norm_topk_prob": True,
+            "layer_norm_epsilon": 1e-5,
+            "vocab_size": 1024,
+            "max_position_embeddings": 1048576,
+            "eos_token_id": 11,
+            "num_nextn_predict_layers": 1,
+        },
+        "vision_config": {"model_type": "radio"},
+    }
+
+
+def load(tmp_path, config):
+    (tmp_path / "config.json").write_text(json.dumps(config))
+    return Config.from_directory(str(tmp_path))
+
+
+def test_nested_model_and_mtp_keep_publisher_keys(tmp_path):
+    source = source_config()
+    save_file({"language_model.mtp.layers.0.eh_proj.weight": torch.zeros(1)}, str(tmp_path / "mtp.safetensors"))
+    config = load(tmp_path, source)
+    assert config.max_position_embeddings == 1048576
+    assert config.vocab_size == 1024
+    assert config.eos_token_id == 11
+    assert config.num_hidden_layers == 3
+    assert config.hybrid_override_pattern == "ME*"
+    assert config.num_experts_per_tok == 22
+    assert config.moe_latent_size == 64
+    assert math.isinf(config.time_step_limit[1])
+    assert set(config.model_classes) == {"text", "mtp"}
+    assert config.config_dict == source  # saved metadata is not rewritten in memory
+    text = Model.from_config(config)
+    draft = Model.from_config(config, component = "mtp")
+    assert text.modules[0].key == "language_model.backbone.embeddings"
+    assert text.modules[-1].key == "language_model.lm_head"
+    assert all(m.key.startswith("language_model.") for m in text.modules + draft.modules)
+    assert draft.input_layer.key == "language_model.mtp.layers.0.input"
+
+
+def test_converted_exl3_config_can_reload(tmp_path):
+    source = source_config()
+    source["quantization_config"] = {"quant_method": "exl3", "bits": 3.0}
+    config = load(tmp_path, source)
+    assert set(config.model_classes) == {"text"}
+
+
+def test_original_nemotron_keys_unchanged(tmp_path):
+    source = text_config_view(source_config())
+    config = load(tmp_path, source)
+    model = Model.from_config(config)
+    assert config.tensor_prefix == ""
+    assert model.modules[0].key == "backbone.embeddings"
+    assert model.modules[1].key == "backbone.layers.0"
+    assert model.modules[-1].key == "lm_head"
+
+
+def test_rejects_nvfp4_before_tensor_loading(tmp_path):
+    source = source_config()
+    source["quantization_config"] = {"quant_method": "modelopt", "quant_algo": "NVFP4"}
+    with pytest.raises(ValueError, match="requires BF16 or EXL3"):
+        load(tmp_path, source)
+
+
+@pytest.mark.parametrize("change", [
+    {"layers_block_type": ["mamba", "unknown"]},
+    {"num_hidden_layers": 99},
+    {"hybrid_override_pattern": "MMM"},
+])
+def test_rejects_inconsistent_layer_layout(tmp_path, change):
+    source = source_config()
+    source["llm_config"].update(copy.deepcopy(change))
+    with pytest.raises(ValueError):
+        load(tmp_path, source)
